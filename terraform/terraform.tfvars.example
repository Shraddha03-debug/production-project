aws_region   = "ap-south-1"
project_name = "devops-demo"
environment  = "dev"

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b"]

cluster_version     = "1.29"
node_instance_type  = "t3.medium"
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3